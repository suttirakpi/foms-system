stateDiagram-v2
direction LR

state "การเปิด/ปิดข้อมูลและลิงก์" as Sys
state "บัญชีผู้ใช้ (User)" as UserLife
state "ศาลา/เมรุ (Hall)" as HallLife
state "แพ็กเกจ / ตัวเลือกเสริม / รายชื่อพระ" as MasterLife
state "ลิงก์บัตรเชิญ (shareToken)" as Invite

state "Active<br/>ใช้งานได้" as U_on
state "Suspended<br/>ระงับ (เข้าสู่ระบบไม่ได้ เซสชันเดิมใช้ไม่ได้ทันที)" as U_off
state "Open<br/>เปิดใช้งาน" as H_on
state "Suspended<br/>ระงับ (เจ้าภาพรายใหม่จองไม่ได้)" as H_off
state "Active<br/>เปิดใช้งาน" as M_on
state "Inactive<br/>ระงับ (ซ่อนจากหน้าจอง/รายการจัดพระ)" as M_off
state "NoLink<br/>ยังไม่มีลิงก์" as L_none
state "Active<br/>ลิงก์ใช้ได้ (ไม่ต้องล็อกอิน)" as L_on
state "Revoked<br/>ถูกยกเลิก (ลิงก์เดิมเปิดไม่ได้)" as L_off

state Sys {
  state UserLife {
    [*] --> U_on : สมัครเอง (HOST) หรือแอดมินสร้างบัญชี
    U_on --> U_off : แอดมินระงับ (ระงับตัวเองไม่ได้)
    U_off --> U_on : แอดมินเปิดใช้งาน
  }
  --
  state HallLife {
    [*] --> H_on : แอดมินเพิ่มศาลา
    H_on --> H_off : ระงับ (ถ้ามีงานค้าง ต้องยืนยันซ้ำ)
    H_off --> H_on : เปิดใช้งาน
  }
  --
  state MasterLife {
    [*] --> M_on : แอดมินเพิ่มรายการ
    M_on --> M_off : ระงับ
    M_off --> M_on : เปิดใช้งาน
  }
  --
  state Invite {
    [*] --> L_none
    L_none --> L_on : เจ้าภาพกด "สร้างลิงก์บัตรเชิญ"
    L_on --> L_off : เจ้าภาพยกเลิกลิงก์
    L_off --> L_on : สร้างใหม่ (ได้โทเคนใหม่)
  }
}
