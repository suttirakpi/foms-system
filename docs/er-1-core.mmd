classDiagram
direction TB

class Temple["วัด (Temple)"] {
  _id : ObjectId
  name : String
  address : String
  province : String
  bankName : String
  bankAccount : String
  isActive : Boolean
}

class Hall["ศาลา/เมรุ (Hall, Embedded)"] {
  _id : ObjectId
  name : String
  capacity : Number
  pricePerNight : Number
  kind : HALL | CREMATORIUM
  isActive : Boolean
  code : String
  description : String
  equipment : String
  feeNote : String
}

class User["ผู้ใช้งาน (User)"] {
  _id : ObjectId
  name : String
  phone : String unique
  email : String unique
  password : String hash
  role : ADMIN | STAFF | OPS | HOST
  templeId : ObjectId
  pdpaConsent : Boolean
  isActive : Boolean
  lastLoginAt : Date
  createdAt / updatedAt : Date
}

class Package["แพ็กเกจ (Package)"] {
  _id : ObjectId
  name : String
  level : Economy | Standard | Premium
  basePrice : Number
  snackPerHead : Number
  desc : String
  features : String[]
  recommended : Boolean
  sortOrder : Number
  isActive : Boolean
}

class Addon["ตัวเลือกเสริม (Addon)"] {
  _id : ObjectId
  name : String
  price : Number
  categoryKey : String
  categoryName : String
  packageIds : ObjectId[]
  isDefault : Boolean
  sortOrder : Number
  isActive : Boolean
}

class Booking["การจอง (Booking)"] {
  _id : ObjectId
  bookingRef : String
  hostId : ObjectId
  hostName : String
  deceasedName : String
  templeId : ObjectId
  templeName : String
  hallId : ObjectId
  hallName : String
  hallPricePerNight : Number
  startDate : Date
  endDate : Date วันฌาปนกิจ
  nights : 1 | 3 | 5 | 7
  guests : Number
  packageId : ObjectId
  packageName : String
  packageBasePrice : Number
  snackPerHead : Number
  status : PENDING | CONFIRMED | PAID | IN_PROGRESS | COMPLETED | CANCELLED
  paymentStatus : UNPAID | SLIP_UPLOADED | PARTIAL | PAID
  paymentSlipUrl : String เดิม
  shareToken : String ลิงก์บัตรเชิญ
  rejectReason : String
  cancelReason : String
  createdAt / updatedAt : Date
}

class Pricing["ราคา (pricing, Embedded)"] {
  hallTotal : Number
  snackTotal : Number
  addonsTotal : Number
  grandTotal : Number
}

class BookingAddon["ที่เลือก (addons[], Embedded)"] {
  addonId : ObjectId
  name : String
  price : Number
  categoryKey : String
}

class HallReservation["การล็อกศาลารายคืน (HallReservation)"] {
  _id : ObjectId
  hallId : ObjectId
  bookingId : ObjectId
  date : String YYYY-MM-DD
  unique(hallId, date)
}


Temple "1" *-- "1..*" Hall : ประกอบด้วย
Temple "1" --> "0..*" User : สังกัด (STAFF/OPS)
User "1" --> "0..*" Booking : เจ้าภาพ (hostId)
Temple "1" --> "0..*" Booking
Hall "1" --> "0..*" Booking
Package "1" --> "0..*" Booking
Package "0..*" -- "0..*" Addon : ใช้ได้กับ (packageIds)
Booking *-- "1" Pricing
Booking *-- "0..*" BookingAddon
Addon "1" --> "0..*" BookingAddon : อ้างอิง
Hall "1" --> "0..*" HallReservation
Booking "1" --> "1..*" HallReservation : ล็อกทีละคืน
